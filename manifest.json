{
  "manifest_version": 3,
  "name": "AI Chat Specifier",
  "version": "0.1.0",
  "description": "Tracks usage, model and context size across AI chatbots, warns before limits, hands off conversations, and optimizes prompts.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "AI Chat Specifier"
  },
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*"
      ],
      "js": ["src/settings.js", "src/sites.js", "src/optimizer.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
